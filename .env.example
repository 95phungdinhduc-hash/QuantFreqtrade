# ==== FILE BÍ MẬT — KHÔNG chia sẻ, KHÔNG đưa lên GitHub (đã nằm trong .gitignore) ====

# --- Telegram (lấy từ 4_alert_bot.py cũ) — dùng cho alert bot VÀ Freqtrade ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Gemini AI (để trống = tắt AI, bot chạy thuần toán học) ---
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.8-flash

# --- Freqtrade đọc các biến FREQTRADE__* để ghi đè config.json ---
FREQTRADE__TELEGRAM__ENABLED="false"
FREQTRADE__TELEGRAM__TOKEN=""
FREQTRADE__TELEGRAM__CHAT_ID=""

FREQTRADE__API_SERVER__USERNAME="freqtrader"
FREQTRADE__API_SERVER__PASSWORD=""
FREQTRADE__API_SERVER__JWT_SECRET_KEY=""
FREQTRADE__API_SERVER__WS_TOKEN=""

# --- API key sàn Binance: CHỈ điền khi chuyển sang tiền thật (dry_run=false) ---
# Tạo key KHÔNG có quyền rút tiền (Withdraw) và giới hạn IP.
# FREQTRADE__EXCHANGE__KEY=""
# FREQTRADE__EXCHANGE__SECRET=""

# Địa chỉ API của Freqtrade để dashboard đọc dữ liệu bot
FT_API_URL="http://127.0.0.1:8080"

# 4 bot tiền ảo có nhắn Telegram khi vào/thoát lệnh ảo không (false = chỉ alert bot nhắn tín hiệu)
BOT_TELEGRAM_NOTIFY=false
